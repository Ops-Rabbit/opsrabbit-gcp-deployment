project_id  = "my-gcp-project"
region      = "us-central1"
name_prefix = "opsrabbit"

# ---- Networking ----
# A VPC is always created/used now (Filestore has no public-IP mode), and
# Cloud SQL is always private IP only as a result. Terraform itself never
# needs to reach into the VPC, though -- the backend's own startup
# migration creates the vector extension, using the network path Cloud
# Run's Direct VPC egress already provides at runtime.
create_vpc  = true
subnet_cidr = "10.10.0.0/20"

# For private mode, merge private.tfvars.example and provide customer connectivity/DNS/TLS.
network_mode = "public"

allow_unauthenticated = true

# ---- Images ----
backend_image = "us-central1-docker.pkg.dev/my-gcp-project/opsrabbit/backend@sha256:REPLACE_ME"
web_image     = "us-central1-docker.pkg.dev/my-gcp-project/opsrabbit/web@sha256:REPLACE_ME"

# ---- Request handling ----
# Open event streams count against concurrency; retain capacity for other API calls.
cloud_run_concurrency             = 20
cloud_run_request_timeout_seconds = 3600

# ---- Cloud SQL ----
postgresql_instance_name       = "opsrabbit-pg"
postgresql_tier                = "db-custom-2-8192"
postgresql_disk_size_gb        = 50
postgresql_database_name       = "opsrabbit"
postgresql_administrator_login = "opsrabbit_admin"

# ---- Filestore ----
filestore_tier        = "BASIC_HDD"
filestore_capacity_gb = 1024 # BASIC_SSD requires at least 2560 GiB
filestore_share_name  = "opsrabbit"
filestore_backup_retention_days = 14

# Determine with: docker run --rm --entrypoint sh <backend_image> -c "id -u; id -g"
backend_uid = 1000
backend_gid = 1000

# ---- App origin (required before enabling the application) ----
# Replace this with a routed custom domain or the deterministic Cloud Run URL.
application_origin = "https://opsrabbit.example.com"

# Keep false for the bootstrap apply; flip to true once images are imported
# AND NFS write access has been verified (see README).
application_enabled = false

# postgresql_administrator_password, better_auth_secret, and
# opsrabbit_encryption_key are NOT set here -- export as TF_VAR_* env vars.
