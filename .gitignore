# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json
!*.tfvars.example

# Ignore override files, generally used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Plan output files -- never commit these, they can contain secret values
*.tfplan
*tfplan*

# Backend config, likely environment-specific -- keep backend.tf.example instead
backend.tf

# Lock file: DO commit .terraform.lock.hcl for reproducible provider
# versions across the team and CI -- intentionally NOT listed here.

# OS / editor noise
.DS_Store
.vscode/
.idea/
*.swp